{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    // Python debugging
    {
      "name": "Python: Current File",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal"
    },
    // C++ debugging with GDB (ROS1 catkin workspace)
    {
      "name": "(gdb) Launch ROS1 Node",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/devel/lib/${input:package}/${input:program}",
      "args": [],
      "preLaunchTask": "build",
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [
        {
          "name": "ROS_MASTER_URI",
          "value": "http://localhost:11311"
        }
      ],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    },
    // Attach to running ROS node
    {
      "name": "(gdb) Attach to ROS Node",
      "type": "cppdbg",
      "request": "attach",
      "program": "${workspaceFolder}/devel/lib/${input:package}/${input:program}",
      "processId": "${command:pickProcess}",
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    },
    // ROS1 Launch file via roslaunch
    {
      "name": "ROS1: roslaunch",
      "type": "ros",
      "request": "launch",
      "preLaunchTask": "build",
      "target": "${workspaceFolder}/src/${input:package}/launch/${input:ros_launch}"
    }
  ],
  "inputs": [
    {
      "id": "package",
      "type": "promptString",
      "description": "Package name",
      "default": "my_package"
    },
    {
      "id": "program",
      "type": "promptString",
      "description": "Program/Node name",
      "default": "my_node"
    },
    {
      "id": "ros_launch",
      "type": "promptString",
      "description": "Launch file name",
      "default": "my_launch.launch"
    }
  ]
}
