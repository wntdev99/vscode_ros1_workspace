// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/ubuntu
{
	"dockerFile": "Dockerfile",
	"build": {
		"args": {
			"WORKSPACE": "${containerWorkspaceFolder}"
			// "USERNAME": "watt",
			// "USER_UID": "1000", //Change to match your UID
			// "USER_GID": "1000" // Change to match your GID
		},
		"options": ["--pull"]
	},
	"runArgs": [
		"--name=watt-ros1-noetic-devcontainer",
		"--network=host",
		"--cap-add=SYS_PTRACE",
		"--security-opt=seccomp:unconfined",
		"--security-opt=apparmor:unconfined",
		// X11 host
		"--volume=/tmp/.X11-unix:/tmp/.X11-unix:rw",
		// Wayland host
		"--volume=/mnt/wslg:/mnt/wslg",
		"--ipc=host",
		// uncomment to use intel iGPU
		"--device=/dev/dri",
		// Share user run time settings
		"--volume=/run/user/1000:/run/user/1000" // Change 1000 to match your UID
		// uncomment to use Nvidia GPU with Linux, https://docs.nvidia.com/datacenter/cloud-native/container-toolkit/latest/install-guide.html
		// "--runtime=nvidia"
		// uncomment to use Nvidia GPU with Windows WSL2
		// "--volume=/usr/lib/wsl:/usr/lib/wsl",
		// "--device=/dev/dxg",
		// "--device=/dev/dri/card0",
		// "--device=/dev/dri/renderD128",
		// "--gpus=all"
	],
	"containerEnv": {
		"DISPLAY": "${localEnv:DISPLAY}", // Needed for GUI try ":0" for windows
		"XAUTHORITY": "${localEnv:XAUTHORITY}",
		// For Wayland
		"WAYLAND_DISPLAY": "${localEnv:WAYLAND_DISPLAY}",
		"XDG_RUNTIME_DIR": "${localEnv:XDG_RUNTIME_DIR}",
		// "QT_QPA_PLATFORM": "wayland", // uncomment to force Wayland
		// For audio
		"PULSE_SERVER": "${localEnv:PULSE_SERVER}",
		"LIBGL_ALWAYS_SOFTWARE": "0", // Set "1" for software rendering of opengl
		// For stable GUI in Docker (rviz, rqt, gazebo, flexbe_app)
		"QT_X11_NO_MITSHM": "1",
		"NO_AT_BRIDGE": "1"
	},
	"remoteUser": "watt",
	"initializeCommand": "xhost +local:docker 2>/dev/null || true",
	"postCreateCommand": "sudo chown watt:watt ${containerWorkspaceFolder}/src && vcs import ${containerWorkspaceFolder}/src < ${containerWorkspaceFolder}/ros1.repos && bash -c 'cd ${containerWorkspaceFolder} && for pkg in rosbag_rviz_panel; do [ -f \"$pkg/package.xml\" ] && [ ! -e \"src/$pkg\" ] && ln -sfn \"../$pkg\" \"src/$pkg\"; done && source /opt/ros/${ROS_DISTRO}/setup.bash && sudo apt-get update && rosdep install --from-paths src --ignore-src -y --rosdistro=${ROS_DISTRO} && catkin build'",
	"postStartCommand": "sudo service dbus start 2>/dev/null || true; (rosdep update --rosdistro=$ROS_DISTRO 2>/dev/null || true)",
	"mounts": [
		// Claude Code 인증 정보 유지
		"source=${localEnv:HOME}/.claude,target=/home/watt/.claude,type=bind,consistency=cached",
		// SSH 키 마운트 (GitHub 접근용)
		"source=${localEnv:HOME}/.ssh,target=/home/watt/.ssh,type=bind,readonly",
		// src 폴더 전체를 Docker volume으로 (로컬과 분리)
		"source=ros1_noetic_src,target=${containerWorkspaceFolder}/src,type=volume"
	],
	// Set *default* container specific settings.json values on container create.
	"customizations": {
		"vscode": {
			"settings": {
				"terminal.integrated.hideOnStartup": "never"
			},
			"extensions": [
				"betwo.b2-catkin-tools",
				"DotJoshJohnson.xml",
				"ms-azuretools.vscode-docker",
				"ms-python.autopep8",
				"ms-python.python",
				"ms-vscode.cpptools",
				"Ranch-Hand-Robotics.rde-pack",
				"redhat.vscode-yaml",
				"streetsidesoftware.code-spell-checker",
				"twxs.cmake",
				"yzhang.markdown-all-in-one",
				"zachflower.uncrustify",
				"Anthropic.claude-code"
			]
		}
	}
}
